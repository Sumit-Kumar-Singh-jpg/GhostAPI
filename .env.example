# Local dashboard and a separate read-only supplier portal.
PORT=3000
PORTAL_PORT=3001
# Bind loopback by default. Publishing the portal requires separate deployment.
HOST=127.0.0.1
DATA_DIR=./data

# Optional schema-constrained LLM planner. No API calls without explicit model,
# key and per-call charge bound. Otherwise the UI labels the rules fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
PLANNER_MAX_COST_USD=
CYCLE_BUDGET_USD=1

# Optional provider integration. Remote browsing remains blocked until an actual
# supported pre-action execution boundary is implemented and tested.
TINYFISH_API_KEY=
TINYFISH_MAX_RUN_COST_USD=
PUBLIC_PORTAL_ORIGIN=

# REA is invoked directly from the pinned local npm dependency (no shell).

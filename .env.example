# Local dashboard and a separate read-only supplier portal.
PORT=3000
PORTAL_PORT=3001
# Bind loopback by default. Publishing the portal requires separate deployment.
HOST=127.0.0.1
DATA_DIR=./data

# Required for public deployment. Use a password of at least 16 characters.
# Keep these in local/server environment variables, never in Git.
PUBLIC_ORIGIN=
ADMIN_PASSWORD=
TRUST_PROXY=0
# Docker Compose additionally reads GHOSTAPI_DOMAIN and GHOSTAPI_ADMIN_PASSWORD.

# Optional schema-constrained LLM planner. No API calls without explicit model,
# key and per-call charge bound. Otherwise the UI labels the rules fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
PLANNER_MAX_COST_USD=
CYCLE_BUDGET_USD=1

# TinyFish Browser mode uses an enforced CDP read-only bridge to the local
# supplier portal. Autonomous Agent API execution is a separate unavailable mode.
TINYFISH_API_KEY=
TINYFISH_MAX_RUN_COST_USD=
PUBLIC_PORTAL_ORIGIN=

# REA is invoked directly from the pinned local npm dependency (no shell).

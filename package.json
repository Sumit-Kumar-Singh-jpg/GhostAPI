{
  "name": "ghostapi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Evidence-based repair and verification for read-only website workflows",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "start:built": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test",
    "rea:version": "rea --version",
    "portal": "tsx src/portal/server.ts",
    "format": "prettier --write src tests scripts public playwright.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts public playwright.config.ts package.json tsconfig.json",
    "smoke:remote": "tsx scripts/remote-smoke.ts",
    "smoke:remote:full": "tsx scripts/remote-smoke.ts --full"
  },
  "dependencies": {
    "@tiny-fish/sdk": "^0.10.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.43.0",
    "playwright-core": "^1.64.1",
    "rea-agents": "6.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "rea-agents": {
      "zod": "4.6.7"
    }
  }
}
